---
interface Props {
  date: Date;
  short?: boolean;
}

const { date, short = false } = Astro.props;

const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: short ? 'short' : 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<time datetime={date.toISOString()}>{formatted}</time>
