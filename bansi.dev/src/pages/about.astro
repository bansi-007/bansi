---
import Base from '../layouts/Base.astro';
import {
  SITE,
  SOCIALS,
  STACK,
  CERTS,
  MEDIUM_URL,
  MEDIUM_ARCHIVE,
  EXPERIENCE,
  EDUCATION,
} from '../consts';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const fmtMonth = (s: string) => {
  const [y, m] = s.split('-');
  return m ? `${MONTHS[Number(m) - 1]} ${y}` : y;
};

const rangeLabel = (start: string, end: string | null) =>
  `${fmtMonth(start)} – ${end ? fmtMonth(end) : 'Present'}`;

// Duration computed at build time, so "Present" roles never go stale.
const duration = (start: string, end: string | null) => {
  const now = new Date();
  const toYM = (s: string | null, isEnd: boolean) => {
    if (!s) return { y: now.getUTCFullYear(), m: now.getUTCMonth() };
    const [y, m] = s.split('-').map(Number);
    return { y, m: m ? m - 1 : isEnd ? 11 : 0 };
  };
  const yearOnly = !start.includes('-') && (!end || !end.includes('-'));
  const a = toYM(start, false);
  const b = toYM(end, true);
  if (yearOnly) {
    const yy = b.y - a.y;
    return `${yy} yr${yy !== 1 ? 's' : ''}`;
  }
  const months = (b.y - a.y) * 12 + (b.m - a.m);
  if (months < 12) return `${Math.max(1, months)} mos`;
  const y = Math.round(months / 12);
  return `${y} yr${y !== 1 ? 's' : ''}`;
};

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

const groups = [
  { label: 'Current', items: EXPERIENCE.filter((e) => e.end === null) },
  { label: 'Past', items: EXPERIENCE.filter((e) => e.end !== null) },
  { label: 'Education', items: EDUCATION },
];
---

<Base
  title="About"
  description="Machine learning engineer working on computer vision, MLOps, and GenAI."
>
  <div class="split">
    <aside class="split__side side-intro">
      <img
        class="side-intro__photo"
        src="/images/bansi.jpg"
        alt={`${SITE.author}, on a boat in a mangrove channel`}
        width="800"
        height="800"
        loading="eager"
      />
      <p class="eyebrow">About</p>
      <h1>{SITE.author}</h1>
      <p>
        Machine learning engineer with 7.5+ years of experience building and
        operating production ML systems: computer vision, MLOps on GCP and
        Azure, and more recently GenAI.
      </p>
      <p>
        {SITE.domain} is where I write about that work. Opinions here are mine
        alone, and nothing proprietary makes it onto the page.
      </p>
      <ul class="links-row">
        {SOCIALS.map((s) => (
          <li><a href={s.href} rel="me noopener">{s.label}</a></li>
        ))}
      </ul>
    </aside>

    <div class="split__main prose">
      <h2>Career</h2>
      <div class="cv">
        {groups.map((g) => (
          <section class="cv__group">
            <p class="cv__glabel">{g.label}</p>
            <ol class="cv__list">
              {g.items.map((it) => (
                <li class={`cv__item${it.end === null ? ' is-now' : ''}`}>
                  <span class="cv__dot" aria-hidden="true"></span>
                  <div class="cv__row">
                    <h3 class="cv__role">{it.role}</h3>
                    <span class="cv__dur">{duration(it.start, it.end)}</span>
                  </div>
                  <p class="cv__org">{it.org}</p>
                  <p class="cv__meta">{rangeLabel(it.start, it.end)} · {it.location}</p>
                  {it.note && <p class="cv__note">{it.note}</p>}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      <h2>Skills</h2>
      <ul class="timeline">
        {
          STACK.map((row) => (
            <li>
              <span class="timeline__period">{row.group}</span>
              <span class="timeline__body">{row.items}</span>
            </li>
          ))
        }
      </ul>

      <h2>Certifications</h2>
      <ul>
        {CERTS.map((cert) => <li>{cert}</li>)}
      </ul>

      <h2>Writing on Medium</h2>
      <p>
        Earlier technical writing lives on <a href={MEDIUM_URL}>Medium</a>. New
        posts land here, but the archive is all still worth reading:
      </p>
      <ul>
        {
          MEDIUM_ARCHIVE.map((piece) => (
            <li>
              <a href={piece.href} rel="noopener">{piece.title}</a>
              {' '}<span class="timeline__period">· {fmt(piece.date)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
