---
import Base from '../layouts/Base.astro';
import {
  SITE,
  SOCIALS,
  STACK,
  CERTS,
  MEDIUM_URL,
  MEDIUM_ARCHIVE,
  EXPERIENCE,
  EDUCATION,
  FOCUS,
  CAREER_START,
} from '../consts';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const fmtMonth = (s: string) => {
  const [y, m] = s.split('-');
  return m ? `${MONTHS[Number(m) - 1]} ${y}` : y;
};

const rangeLabel = (start: string, end: string | null) =>
  `${fmtMonth(start)} – ${end ? fmtMonth(end) : 'Present'}`;

// Durations are computed at build time, so "Present" roles never go stale.
const now = new Date();
const monthsBetween = (start: string, end: string | null) => {
  const toYM = (s: string | null, isEnd: boolean) => {
    if (!s) return { y: now.getUTCFullYear(), m: now.getUTCMonth() };
    const [y, m] = s.split('-').map(Number);
    return { y, m: m ? m - 1 : isEnd ? 11 : 0 };
  };
  const a = toYM(start, false);
  const b = toYM(end, true);
  return (b.y - a.y) * 12 + (b.m - a.m);
};

const duration = (start: string, end: string | null) => {
  if (!start.includes('-')) {
    const yy = Number(end) - Number(start);
    return `${yy} yr${yy !== 1 ? 's' : ''}`;
  }
  const months = monthsBetween(start, end);
  if (months < 12) return `${Math.max(1, months)} mos`;
  const y = Math.round(months / 12);
  return `${y} yr${y !== 1 ? 's' : ''}`;
};

const years = Math.floor(monthsBetween(CAREER_START, null) / 12);

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

// Top floor first. Floors narrow as you go down: scope grew with every role.
const floors = [...EXPERIENCE, ...EDUCATION];
const width = (i: number) => 100 - i * (42 / (floors.length - 1));
const floorNo = (i: number) => (i === floors.length - 1 ? 'G' : `F${floors.length - 1 - i}`);
---

<Base
  title="About"
  description="Staff AI Engineer building production AI systems: platforms, MLOps and LLMOps, agents, and computer vision."
>
  <div class="split">
    <aside class="split__side side-intro">
      <img
        class="side-intro__photo"
        src="/images/bansi.jpg"
        alt={`${SITE.author}, on a boat in a mangrove channel`}
        width="800"
        height="800"
        loading="eager"
      />
      <p class="eyebrow">About</p>
      <h1>{SITE.author}</h1>
      <p>
        Staff AI Engineer at Micron Technology. For {years}+ years I have been
        taking machine learning from prototype to production: computer vision,
        MLOps on GCP and Azure, and now LLMs and agents.
      </p>
      <p>
        {SITE.domain} is where I write about that work. Opinions here are mine
        alone, and nothing proprietary makes it onto the page.
      </p>
      <ul class="links-row">
        {SOCIALS.map((s) => (
          <li><a href={s.href} rel="me noopener">{s.label}</a></li>
        ))}
      </ul>
    </aside>

    <div class="split__main prose">
      <h2>What I work on</h2>
      <div class="focus">
        {FOCUS.map((f, i) => (
          <div class="focus__card">
            <span class="focus__no">0{i + 1}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>

      <h2>One floor up, every time</h2>
      <p class="floors__lede">
        Looking back, every role moved me one floor up. First I built a model on
        a device. Then services around models, systems around services, and
        platforms around systems. Now the job is deciding what the platforms
        should be. Read it from the top, or start at the ground floor.
      </p>

      <ol class="floors">
        {floors.map((f, i) => (
          <li
            class={`floor${f.end === null ? ' is-now' : ''}${i === floors.length - 1 ? ' is-ground' : ''}`}
            style={`--w: ${width(i).toFixed(1)}%`}
          >
            <div class="floor__tag">
              <span class="floor__no">{floorNo(i)}</span>
              <span class="floor__scope">{f.scope}</span>
            </div>
            <div class="floor__body">
              <div class="floor__row">
                <h3 class="floor__role">{f.role}</h3>
                {f.end === null && <span class="floor__here">you are here</span>}
              </div>
              <p class="floor__org">
                {f.logo ? <img src={f.logo} alt={f.org} title={f.org} loading="lazy" /> : f.org}
              </p>
              <p class="floor__meta">
                {rangeLabel(f.start, f.end)} · {duration(f.start, f.end)} · {f.location}
              </p>
              {f.note && <p class="floor__note">{f.note}</p>}
            </div>
          </li>
        ))}
      </ol>

      <h2>Where the writing comes from</h2>
      <p>
        In college, my favourite job had nothing to do with grades. It was
        explaining an entire semester's subject to my friends an hour before the
        exam. Compressing a semester into an hour only works if you understand the
        subject by intuition, not by formula, and that turned out to be the most
        useful skill I learned there.
      </p>
      <p>
        This blog is that same hour, for whatever I am learning now. It's why the
        posts lean on small worked examples and diagrams, and why most of them end
        with code you can run yourself.
      </p>

      <h2>Recognition</h2>
      <p>
        Twenty honours and awards so far. The two most recent, both from January 2026:
      </p>
      <ul>
        <li>
          <strong>Innovation</strong>, for a video analytics solution that gave
          near real-time operational insight and was delivered quickly by reusing
          existing analytics capabilities.
        </li>
        <li>
          <strong>Customer Focus</strong>, for catching a platform incompatibility
          in production and escalating it early, before it could reach downstream
          systems.
        </li>
      </ul>

      <h2>Skills</h2>
      <ul class="timeline">
        {
          STACK.map((row) => (
            <li>
              <span class="timeline__period">{row.group}</span>
              <span class="timeline__body">{row.items}</span>
            </li>
          ))
        }
      </ul>

      <h2>Certifications</h2>
      <ul>
        {CERTS.map((cert) => <li>{cert}</li>)}
      </ul>

      <h2>Writing on Medium</h2>
      <p>
        Earlier technical writing lives on <a href={MEDIUM_URL}>Medium</a>. New
        posts land here, but the archive is all still worth reading:
      </p>
      <ul>
        {
          MEDIUM_ARCHIVE.map((piece) => (
            <li>
              <a href={piece.href} rel="noopener">{piece.title}</a>
              {' '}<span class="timeline__period">· {fmt(piece.date)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
