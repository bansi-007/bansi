---
import Base from '../layouts/Base.astro';
import {
  SITE,
  SOCIALS,
  STACK,
  CERTS,
  MEDIUM_URL,
  MEDIUM_ARCHIVE,
  EXPERIENCE,
  EDUCATION,
  FOCUS,
  CAREER_START,
} from '../consts';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const fmtMonth = (s: string) => {
  const [y, m] = s.split('-');
  return m ? `${MONTHS[Number(m) - 1]} ${y}` : y;
};

const rangeLabel = (start: string, end: string | null) =>
  `${fmtMonth(start)} – ${end ? fmtMonth(end) : 'Present'}`;

// Durations are computed at build time, so "Present" roles never go stale.
const now = new Date();
const monthsBetween = (start: string, end: string | null) => {
  const toYM = (s: string | null, isEnd: boolean) => {
    if (!s) return { y: now.getUTCFullYear(), m: now.getUTCMonth() };
    const [y, m] = s.split('-').map(Number);
    return { y, m: m ? m - 1 : isEnd ? 11 : 0 };
  };
  const a = toYM(start, false);
  const b = toYM(end, true);
  return (b.y - a.y) * 12 + (b.m - a.m);
};

const duration = (start: string, end: string | null) => {
  if (!start.includes('-')) {
    const yy = Number(end) - Number(start);
    return `${yy} yr${yy !== 1 ? 's' : ''}`;
  }
  const months = monthsBetween(start, end);
  if (months < 12) return `${Math.max(1, months)} mos`;
  const y = Math.round(months / 12);
  return `${y} yr${y !== 1 ? 's' : ''}`;
};

const years = Math.floor(monthsBetween(CAREER_START, null) / 12);

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

// ---- Career as a training run ---------------------------------------------
// Education is pretraining; each role is a checkpoint; y = scope of the work.
const LEVELS = ['pretraining', 'device', 'service', 'system', 'platform', 'integration', 'end-to-end'];
const nowT = now.getUTCFullYear() + now.getUTCMonth() / 12;
const toT = (s: string | null, isEnd = false) => {
  if (!s) return nowT;
  const [y, m] = s.split('-').map(Number);
  return y + (m ? m - 1 : isEnd ? 5 : 0) / 12;
};
const stages = [...EDUCATION, ...[...EXPERIENCE].reverse()].map((s, i) => ({
  ...s,
  ckpt: i === 0 ? 'pretraining' : `ckpt-${String(i).padStart(2, '0')}`,
  level: LEVELS.indexOf(s.scope === 'foundation' ? 'pretraining' : s.scope),
}));

const T0 = 2014;
const T1 = nowT + 0.35;
const X0 = 104;
const X1 = 700;
const xOf = (t: number) => X0 + ((t - T0) / (T1 - T0)) * (X1 - X0);
const yOf = (lvl: number) => 226 - lvl * 30;

let curve = `M ${xOf(toT(stages[0].start)).toFixed(1)} ${yOf(0)}`;
for (const s of stages.slice(1)) curve += ` H ${xOf(toT(s.start)).toFixed(1)} V ${yOf(s.level)}`;
curve += ` H ${xOf(nowT).toFixed(1)}`;

const preEnd = xOf(toT(stages[0].end, true));
const yearTicks = Array.from({ length: Math.floor(nowT) - T0 + 1 }, (_, i) => T0 + i).filter((y) => y % 2 === 0);
const current = stages[stages.length - 1];
---

<Base
  title="About"
  description="Staff AI Engineer building production AI systems: platforms, MLOps and LLMOps, agents, and computer vision."
>
  <div class="split">
    <aside class="split__side side-intro">
      <img
        class="side-intro__photo"
        src="/images/bansi-micron.jpg"
        alt={`${SITE.author}, standing outside a Micron building`}
        width="800"
        height="800"
        loading="eager"
      />
      <p class="eyebrow">About</p>
      <h1>{SITE.author}</h1>
      <p class="side-intro__tagline">Writes Sense on Nonsense When Bored</p>
      <p>
        Staff AI Engineer at Micron Technology. For {years}+ years I have been
        taking machine learning from prototype to production: computer vision,
        MLOps on GCP and Azure, and now LLMs and agents.
      </p>
      <p>
        {SITE.domain} is where I write about that work. Opinions here are mine
        alone, and nothing proprietary makes it onto the page.
      </p>
      <ul class="links-row">
        {SOCIALS.map((s) => (
          <li><a href={s.href} rel="me noopener">{s.label}</a></li>
        ))}
      </ul>
    </aside>

    <div class="split__main prose">
      <section class="mcard" aria-label="Model card">
        <div class="mcard__head">
          <span>model card</span>
          <span>bansi-dath-maddali</span>
        </div>
        <dl class="mcard__rows">
          <dt>role</dt>
          <dd>{current.role}, {current.org}</dd>
          <dt>base model</dt>
          <dd>{EDUCATION[0].role}, {EDUCATION[0].org}</dd>
          <dt>trained on</dt>
          <dd>{years}+ years of production ML: computer vision, MLOps on GCP and Azure, LLMs and agents</dd>
          <dt>intended use</dt>
          <dd class="mcard__chips">{FOCUS.map((f) => <a href={`#use-${f.key}`}>{f.title}</a>)}</dd>
          <dt>languages</dt>
          <dd>English, Telugu</dd>
          <dt>deployed in</dt>
          <dd>{current.location}</dd>
        </dl>
      </section>

      <h2>Intended use</h2>
      <p class="use__lede">
        The kinds of problems this model is built for, the tools it usually reaches
        for, and the checkpoints where it learned them.
      </p>
      <div class="use">
        {FOCUS.map((f, i) => (
          <article class="use__card" id={`use-${f.key}`}>
            <header class="use__head">
              <span class="use__glyph" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  {f.key === 'platforms' && (
                    <>
                      <path d="M16 5 28 11 16 17 4 11z" />
                      <path d="M4 16l12 6 12-6" />
                      <path d="M4 21l12 6 12-6" />
                    </>
                  )}
                  {f.key === 'mlops' && (
                    <>
                      <circle cx="16" cy="16" r="10" />
                      <path d="M24.92 8.01 24.66 11l-2.72-1.27" />
                      <circle cx="16" cy="6" r="2.6" fill="currentColor" stroke="none" />
                      <circle cx="7.34" cy="21" r="2.6" fill="currentColor" stroke="none" />
                      <circle cx="24.66" cy="21" r="2.6" fill="currentColor" stroke="none" />
                    </>
                  )}
                  {f.key === 'agents' && (
                    <>
                      <circle cx="16" cy="16" r="4.5" />
                      <path d="M16 11.5V6M12.2 18.4 7.5 21.5M19.8 18.4l4.7 3.1" />
                      <rect x="13" y="2" width="6" height="4" rx="1" />
                      <rect x="3" y="20.5" width="6" height="4" rx="1" />
                      <rect x="23" y="20.5" width="6" height="4" rx="1" />
                    </>
                  )}
                  {f.key === 'vision' && (
                    <>
                      <path d="M4 10V4h6M22 4h6v6M28 22v6h-6M10 28H4v-6" />
                      <rect x="10" y="10" width="12" height="12" rx="1" />
                      <path d="M10 8.5h7" />
                      <circle cx="16" cy="16" r="1.5" fill="currentColor" stroke="none" />
                    </>
                  )}
                </svg>
              </span>
              <h3>{f.title}</h3>
              <span class="use__no">0{i + 1}</span>
            </header>
            <p class="use__body">{f.body}</p>
            <div class="use__row">
              <span class="use__label">stack</span>
              <span class="use__stack">{f.stack.map((s) => <span>{s}</span>)}</span>
            </div>
            <div class="use__row">
              <span class="use__label">evidence</span>
              <span class="use__ev">
                {f.ckpts.map((n) => <a href={`#ckpt-0${n}`}>ckpt-0{n}</a>)}
              </span>
            </div>
          </article>
        ))}
      </div>

      <h2>The training run</h2>
      <p class="run__lede">
        If my career were a training run, college would be pretraining and each
        role a checkpoint. The metric that kept going up is scope: from one model
        on one device to owning AI systems end to end, from design to production.
      </p>

      <figure class="run">
        <div class="run__scroll">
        <svg viewBox="0 0 720 262" role="img" aria-label={`Career as a step curve from ${T0} to now. Scope rises from pretraining through device, service, system, platform and integration to strategy.`}>
          <g font-family="ui-monospace, Menlo, monospace" font-size="11" fill="currentColor">
            <rect x={xOf(T0)} y="30" width={(preEnd - xOf(T0)).toFixed(1)} height="206" fill="var(--accent)" fill-opacity="0.07" />
            <text x={((xOf(T0) + preEnd) / 2).toFixed(1)} y="22" text-anchor="middle" font-size="10.5" fill="var(--accent)">pretraining</text>
            {LEVELS.map((l, i) => (
              <>
                <line x1={X0} x2={X1} y1={yOf(i)} y2={yOf(i)} stroke="var(--rule)" stroke-dasharray="2 4" />
                <text x={X0 - 10} y={yOf(i) + 4} text-anchor="end" font-size="10.5" fill="var(--muted)">{l}</text>
              </>
            ))}
            <line x1={X0} x2={X1} y1="236" y2="236" stroke="var(--muted)" stroke-width="0.8" />
            {yearTicks.map((y) => (
              <text x={xOf(y).toFixed(1)} y="252" text-anchor="middle" font-size="10.5" fill="var(--muted)">{y}</text>
            ))}
            <path d={curve} fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" />
            {stages.slice(1, -1).map((s) => (
              <>
                <circle cx={xOf(toT(s.start)).toFixed(1)} cy={yOf(s.level)} r="4" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.6" />
                <text x={(xOf(toT(s.start)) - 6).toFixed(1)} y={yOf(s.level) - 8} text-anchor="end" font-size="9.5" fill="var(--muted)">{s.ckpt}</text>
              </>
            ))}
            <circle class="run__now" cx={xOf(nowT).toFixed(1)} cy={yOf(current.level)} r="5" fill="var(--accent)" />
            <circle cx={xOf(toT(current.start)).toFixed(1)} cy={yOf(current.level)} r="4" fill="var(--bg)" stroke="var(--accent)" stroke-width="1.6" />
            <text x={(xOf(toT(current.start)) - 8).toFixed(1)} y={yOf(current.level) - 10} text-anchor="end" font-size="10.5" fill="var(--accent)">{current.ckpt} · now, still training</text>
          </g>
        </svg>
        </div>
        <figcaption>Scope of the work over time. Each step up is a new role.</figcaption>
      </figure>

      <h2>Checkpoints</h2>
      <ol class="ckpts">
        {stages.map((s) => (
          <li class={`ckpt${s.end === null ? ' is-now' : ''}`} id={s.ckpt}>
            <div class="ckpt__tag">
              <span class="ckpt__id">{s.ckpt}</span>
              <span class="ckpt__scope">{s.level === 0 ? 'base' : s.scope}</span>
            </div>
            <div class="ckpt__body">
              <div class="ckpt__row">
                <h3 class="ckpt__role">{s.role}</h3>
                {s.end === null && <span class="ckpt__status">current role · still training</span>}
              </div>
              <p class="ckpt__org">
                {s.logo ? <img src={s.logo} alt={s.org} title={s.org} loading="lazy" /> : s.org}
              </p>
              <p class="ckpt__meta">
                {rangeLabel(s.start, s.end)} · {duration(s.start, s.end)} · {s.location}
              </p>
              {s.note && <p class="ckpt__note">{s.note}</p>}
            </div>
          </li>
        ))}
      </ol>

      <h2>Where the writing comes from</h2>
      <p>
        In college, the part I enjoyed most had nothing to do with grades: explaining
        a whole semester's subject to my friends an hour before the exam. That only
        works if you understand the subject intuitively rather than by rote.
      </p>
      <p>
        This blog tries to do the same for whatever I'm learning now, which is why
        most posts use small worked examples and diagrams, and end with code you can
        run yourself.
      </p>

      <h2>Recognition</h2>
      <p>
        Twenty honours and awards so far. The two most recent, both from January 2026:
      </p>
      <ul>
        <li>
          <strong>Innovation</strong>, for a video analytics solution that gave
          near real-time operational insight and was delivered quickly by reusing
          existing analytics capabilities.
        </li>
        <li>
          <strong>Customer Focus</strong>, for catching a platform incompatibility
          in production and escalating it early, before it could reach downstream
          systems.
        </li>
      </ul>

      <h2>Skills</h2>
      <ul class="timeline">
        {
          STACK.map((row) => (
            <li>
              <span class="timeline__period">{row.group}</span>
              <span class="timeline__body">{row.items}</span>
            </li>
          ))
        }
      </ul>

      <h2>Certifications</h2>
      <ul>
        {CERTS.map((cert) => <li>{cert}</li>)}
      </ul>

      <h2>Writing on Medium</h2>
      <p>
        Earlier technical writing lives on <a href={MEDIUM_URL}>Medium</a>. New
        posts land here, but the archive is all still worth reading:
      </p>
      <ul>
        {
          MEDIUM_ARCHIVE.map((piece) => (
            <li>
              <a href={piece.href} rel="noopener">{piece.title}</a>
              {' '}<span class="timeline__period">· {fmt(piece.date)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
